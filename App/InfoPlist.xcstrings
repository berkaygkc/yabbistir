{
  "sourceLanguage" : "en",
  "strings" : {
    "NSAppleEventsUsageDescription" : {
      "comment" : "Shown by macOS when an installed extension first sends Apple events to another app.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige Erweiterungen, die du installierst, kommunizieren mit anderen Apps, zum Beispiel um die offenen Tabs in Safari zu lesen oder eine Notiz in Notizen anzulegen. macOS fragt für jede App einmal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some extensions you install talk to other apps, for example to read Safari's open tabs or to add a note to Notes. macOS asks once for each app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunas extensiones que instalas se comunican con otras apps, por ejemplo para leer las pestañas abiertas de Safari o para añadir una nota en Notas. macOS lo pregunta una vez por cada app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certaines extensions que vous installez communiquent avec d’autres apps, par exemple pour lire les onglets ouverts de Safari ou ajouter une note dans Notes. macOS vous le demande une fois pour chaque app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インストールした一部の機能拡張は、Safariで開いているタブの読み取りや“メモ”へのメモの追加など、ほかのアプリとやり取りします。macOSは各アプリについて1回確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설치한 일부 확장 프로그램은 Safari의 열린 탭을 읽거나 메모 앱에 내용을 추가하는 등 다른 앱과 통신합니다. macOS는 앱마다 한 번씩 묻습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurduğun bazı uzantılar başka uygulamalarla konuşur; örneğin Safari'de açık sekmeleri okur ya da Notlar'a not ekler. macOS her uygulama için bir kez sorar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你安装的某些扩展会与其他App通信，例如读取“Safari浏览器”中已打开的标签页，或在“备忘录”中新建一条备忘录。macOS会对每个App询问一次。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你安裝的某些延伸功能會與其他App溝通，例如讀取Safari中已開啟的標籤頁，或在「備忘錄」中新增一則備忘錄。macOS會對每個App詢問一次。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
