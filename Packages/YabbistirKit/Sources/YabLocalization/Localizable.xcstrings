    "settings.permissions.inputMonitoring.purpose": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lässt den Stapel dein ⌘V erkennen, damit nach jedem Einsetzen das nächste Objekt bereitsteht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets the Stack hear your ⌘V, so the next item comes up after each paste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que la Pila detecte tu ⌘V para que el siguiente ítem aparezca tras cada pegado."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스택이 ⌘V를 인식하여 붙여넣을 때마다 다음 항목이 나타나게 합니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sıra’nın ⌘V’ni duymasını sağlar; her yapıştırmadan sonra sıradaki öğe gelir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让粘贴队列能感知你的⌘V，这样每次粘贴后都会轮到下一个项目。"
          }
        }
      }
    },
    "settings.permissions.inputMonitoring.steps": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suche unter Datenschutz & Sicherheit › Eingabeüberwachung nach yabbistir und schalte es ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Privacy & Security › Input Monitoring, find yabbistir and turn it on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Privacidad y seguridad › Monitorización de los dispositivos de entrada, busca yabbistir y actívalo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개인정보 보호 및 보안 › 입력 모니터링에서 yabbistir를 찾아 켜십시오."
          }
        },
        "tr": {
          "stringUnit": {
