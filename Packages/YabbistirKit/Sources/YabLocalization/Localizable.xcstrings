    "settings.permissions.accessibility.purpose": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzt in die App ein, in der du warst, und findet deine Einfügemarke."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastes into the app you were in and finds your text caret."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pega en la app en la que estabas y localiza tu punto de inserción."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용 중이던 앱에 붙여넣고 삽입점을 찾습니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bulunduğun uygulamaya yapıştırır ve yazı imlecini bulur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴到你所在的App，并找到你的插入点。"
          }
        }
      }
    },
    "settings.permissions.accessibility.steps": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suche unter Datenschutz & Sicherheit › Bedienungshilfen nach yabbistir und schalte es ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Privacy & Security › Accessibility, find yabbistir and turn it on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Privacidad y seguridad › Accesibilidad, busca yabbistir y actívalo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개인정보 보호 및 보안 › 손쉬운 사용에서 yabbistir를 찾아 켜십시오."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizlilik ve Güvenlik › Erişilebilirlik’te yabbistir’i bul ve anahtarını aç."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“隐私与安全性 › 辅助功能”中找到yabbistir并打开它。"
          }
        }
      }
    },
    "settings.permissions.inputMonitoring.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eingabeüberwachung"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Input Monitoring"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitorización de los dispositivos de entrada"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력 모니터링"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Girdi İzleme"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
