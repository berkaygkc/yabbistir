    "settings.permissions.loginItem.purpose": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startet yabbistir bei der Anmeldung, damit dein Verlauf nichts verpasst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starts yabbistir when you log in, so your history keeps up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre yabbistir al iniciar sesión, para que tu historial esté siempre al día."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인할 때 yabbistir를 시작하여 기록이 빠짐없이 쌓이게 합니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturum açınca yabbistir’i başlatır; geçmişin hiç kesilmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录时启动yabbistir，让历史记录保持最新。"
          }
        }
      }
    },
    "settings.permissions.loginItem.steps": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte es unter „Allgemein“ ein. Wenn macOS fragt, bestätige es in den Anmeldeobjekten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn it on in General. If macOS asks, approve it in Login Items."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actívalo en General. Si macOS te lo pregunta, apruébalo en Ítems de inicio."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일반에서 켜십시오. macOS에서 묻는 경우 로그인 항목에서 승인하십시오."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Genel’den aç. macOS onay isterse Giriş Öğeleri’nden onayla."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“通用”中打开。如果macOS询问，请在“登录项”中批准。"
          }
        }
      }
    },
