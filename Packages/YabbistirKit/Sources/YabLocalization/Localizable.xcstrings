    "permissions.exec": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kann diese Programme auf deinem Mac ausführen: %@. Diese Programme können deine Dateien lesen und schreiben und auf das Internet zugreifen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can run these programs on your Mac: %@. They can read and write your files and reach the internet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede ejecutar estos programas en tu Mac: %@. Pueden leer y escribir tus archivos y acceder a internet."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에서 다음 프로그램을 실행할 수 있습니다: %@. 이 프로그램은 파일을 읽고 쓰며 인터넷에 접근할 수 있습니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilgisayarındaki şu programları çalıştırabilir: %@. Bu programlar dosyalarına erişebilir ve internete çıkabilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以在你的Mac上运行这些程序：%@。它们可以读写你的文件并访问互联网。"
          }
        }
      }
    },
