    "settings.history.retention.note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gezählt ab der letzten Verwendung eines Objekts. Objekte in einer Kategorie werden nie entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Counted from the last time you used an item. Items in a category are never removed."
