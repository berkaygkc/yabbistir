          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS henüz sormadı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS尚未询问。"
          }
        }
      }
    },
    "settings.permissions.pasteboard.ask": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS fragt jedes Mal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS asks each time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS lo pregunta cada vez."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS가 매번 묻습니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS her seferinde soruyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS每次都会询问。"
          }
        }
      }
