    "settings.permissions.pasteboard.denied": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deaktiviert: yabbistir kann nicht sehen, was du kopierst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turned off: yabbistir can’t see your copies."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado: yabbistir no puede ver lo que copias."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "꺼짐: yabbistir가 복사한 내용을 볼 수 없습니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapalı: yabbistir kopyaladıklarını göremiyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已关闭：yabbistir看不到你的拷贝内容。"
          }
        }
      }
    },
    "settings.permissions.loginItem.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei der Anmeldung öffnen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open at login"
          }
        },
