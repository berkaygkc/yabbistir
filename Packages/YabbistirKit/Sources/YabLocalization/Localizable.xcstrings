        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se cuenta desde la última vez que usaste un ítem. Los ítems de una categoría nunca se eliminan."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목을 마지막으로 사용한 때부터 계산합니다. 카테고리에 있는 항목은 제거되지 않습니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
