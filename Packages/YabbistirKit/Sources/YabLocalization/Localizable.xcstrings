    "import.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Pinboards werden zu Kategorien. Deine Daten in Paste werden nur gelesen, nie geändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your pinboards become categories. Your data in Paste is only read, never changed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus pinboards pasan a ser categorías. Tus datos de Paste solo se leen, nunca se modifican."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinboard는 카테고리가 됩니다. Paste의 데이터는 읽기만 하며 변경하지 않습니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinboard’ların kategori olur. Paste’teki verine dokunulmaz, yalnızca okunur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的Pinboard会变成分类。yabbistir只会读取你在Paste中的数据，不会更改。"
          }
        }
      }
    },
