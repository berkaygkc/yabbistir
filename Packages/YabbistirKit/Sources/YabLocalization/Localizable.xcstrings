    "permissions.sensitive": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kann geheime Daten wie Passwörter lesen und einsetzen. Diese werden nie in den Verlauf oder auf die Festplatte geschrieben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can read and paste secrets such as passwords. They’re never written to history or disk."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede leer y pegar secretos, como contraseñas. Nunca se escriben en el historial ni en el disco."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "암호 같은 비밀 값을 읽고 붙여넣을 수 있습니다. 기록이나 디스크에는 저장되지 않습니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şifre gibi gizli kayıtları okuyup yapıştırabilir. Bunlar geçmişe ve diske yazılmaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以读取并粘贴密码等机密信息。这些信息绝不会写入历史记录或磁盘。"
          }
        }
      }
    },
