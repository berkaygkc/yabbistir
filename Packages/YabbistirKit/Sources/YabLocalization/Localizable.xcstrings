    "onboarding.welcome.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles, was du kopierst, direkt unter deiner Einfügemarke."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything you copy, right under your caret."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que copias, justo bajo tu punto de inserción."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복사한 모든 것이 삽입점 바로 아래에."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopyaladığın her şey, imlecinin hemen altında."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你拷贝的一切，就在插入点下方。"
          }
        }
      }
    },
    "onboarding.welcome.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "yabbistir merkt sich deinen Verlauf. Drücke den Kurzbefehl, tippe los, setze mit ↵ ein. Ganz ohne Maus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "yabbistir keeps your history. Press the shortcut, start typing, paste with ↵. No mouse needed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "yabbistir guarda tu historial. Pulsa el atajo, empieza a escribir y pega con ↵. Sin tocar el ratón."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "yabbistir가 기록을 보관합니다. 단축키를 누르고, 입력해서 검색하고, ↵로 붙여넣으십시오. 마우스는 필요 없습니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "yabbistir geçmişini saklar. Kısayola bas, yazmaya başla, ↵ ile yapıştır. Fareye hiç dokunmadan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "yabbistir会保存你的历史记录。按下快捷键，开始输入，按↵粘贴。无需鼠标。"
          }
        }
      }
    },
