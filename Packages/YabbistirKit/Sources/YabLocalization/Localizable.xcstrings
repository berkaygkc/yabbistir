          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“隐私与安全性 › 输入监控”中找到yabbistir并打开它。"
          }
        }
      }
    },
    "settings.permissions.pasteboard.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus anderen Apps einsetzen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clipboard access"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pegar desde otras apps"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 앱에서 붙여넣기"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pano erişimi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从其他App粘贴"
          }
        }
      }
    },
    "settings.permissions.pasteboard.purpose": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lässt yabbistir sehen, was du kopierst, damit es deinen Verlauf führen kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets yabbistir see what you copy, so it can keep your history."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que yabbistir vea lo que copias para poder guardar tu historial."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "yabbistir가 복사한 내용을 볼 수 있게 하여 기록을 보관합니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "yabbistir’in kopyaladıklarını görmesini, böylece geçmişini tutmasını sağlar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让yabbistir能看到你拷贝的内容，以便保存历史记录。"
          }
        }
      }
    },
    "settings.permissions.pasteboard.steps": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn macOS fragt, wähle „Immer erlauben“. Du kannst das später unter Datenschutz & Sicherheit ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If macOS asks, choose Always Allow. You can change it later in Privacy & Security."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si macOS te lo pregunta, elige Permitir siempre. Puedes cambiarlo después en Privacidad y seguridad."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS에서 묻는 경우 ‘항상 허용’을 선택하십시오. 나중에 개인정보 보호 및 보안에서 변경할 수 있습니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS sorarsa “Her zaman izin ver”i seç. Sonra Gizlilik ve Güvenlik’ten değiştirebilirsin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果macOS询问，请选择“始终允许”。之后可在“隐私与安全性”中更改。"
          }
        }
      }
    },
    "settings.permissions.pasteboard.notAsked": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS hat noch nicht gefragt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS hasn’t asked yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS aún no lo ha preguntado."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
